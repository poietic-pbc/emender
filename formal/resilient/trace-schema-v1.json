{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spinozans.org/emender/schemas/emender-resilient-coordination-trace-v1.json",
  "title": "Emender resilient DiLoCo pure coordination trace v1",
  "description": "Canonical complete trace consumed and emitted by the Lean pure coordination oracle and the production differential adapter. Dense bytes and physical runtime effects are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaDigest",
    "policyName",
    "policySchema",
    "policyDigest",
    "toolchain",
    "sourceSchema",
    "sourceDigest",
    "initialState",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "emender-resilient-coordination-trace-v1"
    },
    "schemaDigest": {
      "$ref": "#/$defs/digest"
    },
    "policyName": {
      "enum": [
        "resilient-diloco-strict-v1",
        "async-decoupled-v2.1-simple"
      ]
    },
    "policySchema": {
      "enum": [
        "emender-resilient-policy-v1",
        "emender-async-policy-v2.1"
      ]
    },
    "policyDigest": {
      "$ref": "#/$defs/digest"
    },
    "toolchain": {
      "const": "leanprover/lean4:v4.26.0@d8204c9fd894f91bbb2cdfec5912ec8196fd8562"
    },
    "sourceSchema": {
      "const": "emender-async-v21-execution-source-v1"
    },
    "sourceDigest": {
      "$ref": "#/$defs/digest"
    },
    "initialState": {
      "$ref": "#/$defs/initialState"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/traceStep"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "opaque": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        }
      }
    },
    "natIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "nullableOpaque": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/opaque"
        }
      ]
    },
    "nullableDigest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "authorityIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "allocation",
        "fence",
        "policyName",
        "policySchema",
        "policyDigest",
        "traceSchema",
        "traceSchemaDigest",
        "toolchain",
        "sourceSchema",
        "sourceDigest",
        "layoutDigest",
        "codeDigest"
      ],
      "properties": {
        "run": {
          "$ref": "#/$defs/opaque"
        },
        "allocation": {
          "$ref": "#/$defs/opaque"
        },
        "fence": {
          "$ref": "#/$defs/natIdentity"
        },
        "policyName": {
          "type": "string"
        },
        "policySchema": {
          "type": "string"
        },
        "policyDigest": {
          "$ref": "#/$defs/digest"
        },
        "traceSchema": {
          "const": "emender-resilient-coordination-trace-v1"
        },
        "traceSchemaDigest": {
          "$ref": "#/$defs/digest"
        },
        "toolchain": {
          "const": "leanprover/lean4:v4.26.0@d8204c9fd894f91bbb2cdfec5912ec8196fd8562"
        },
        "sourceSchema": {
          "const": "emender-async-v21-execution-source-v1"
        },
        "sourceDigest": {
          "$ref": "#/$defs/digest"
        },
        "layoutDigest": {
          "$ref": "#/$defs/digest"
        },
        "codeDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "schema",
        "digest",
        "qMin",
        "tMin",
        "maxCommitLag",
        "maxAnchorLag",
        "maxResultLag",
        "maxSpeculativeLag",
        "maxOwnerReassignments",
        "attemptRetries",
        "kSteps",
        "closureMode",
        "closureEvidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "strictV1",
            "asyncV21"
          ]
        },
        "name": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "qMin": {
          "type": "integer",
          "minimum": 1
        },
        "tMin": {
          "type": "integer",
          "minimum": 1
        },
        "maxCommitLag": {
          "type": "integer",
          "minimum": 0
        },
        "maxAnchorLag": {
          "type": "integer",
          "minimum": 0
        },
        "maxResultLag": {
          "type": "integer",
          "minimum": 0
        },
        "maxSpeculativeLag": {
          "type": "integer",
          "minimum": 0
        },
        "maxOwnerReassignments": {
          "const": 2
        },
        "attemptRetries": {
          "type": "integer",
          "minimum": 0
        },
        "kSteps": {
          "type": "integer",
          "minimum": 0
        },
        "closureMode": {
          "enum": [
            "floorOrDeadline",
            "fixedSnapshotDeadline"
          ]
        },
        "closureEvidence": {
          "$ref": "#/$defs/opaque"
        }
      }
    },
    "initialState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "policy",
        "baseGeneration",
        "baseDigest",
        "baseReceipt",
        "baseReceiptDigest",
        "acceptedTokenClock",
