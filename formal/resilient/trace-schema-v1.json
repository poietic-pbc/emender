        "generationStatus": {
          "enum": [
            "open",
            "closed",
            "aborted",
            "committed",
            "applied"
          ]
        },
        "ownerEpoch": {
          "$ref": "#/$defs/natIdentity"
        },
        "ownerReassignments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "acceptedTokenClock": {
          "type": "integer",
          "minimum": 0
