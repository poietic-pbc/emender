      ],
      "properties": {
        "run": {
          "$ref": "#/$defs/opaque"
        },
        "allocation": {
          "$ref": "#/$defs/opaque"
        },
        "fence": {
          "$ref": "#/$defs/natIdentity"
        },
        "policyName": {
          "type": "string"
        },
        "policySchema": {
          "type": "string"
        },
        "policyDigest": {
          "$ref": "#/$defs/digest"
        },
        "traceSchema": {
          "type": "string"
        },
        "traceSchemaDigest": {
          "$ref": "#/$defs/digest"
        },
        "toolchain": {
          "type": "string"
