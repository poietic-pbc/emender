        },
        "baseReceiptDigest": {
          "$ref": "#/$defs/digest"
        },
        "acceptedTokenClock": {
          "type": "integer",
          "minimum": 0
        },
        "lastResult": {
          "$ref": "#/$defs/nullableOpaque"
        }
      }
    },
    "eventContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
